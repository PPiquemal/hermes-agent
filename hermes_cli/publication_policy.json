      "workflows": {
        "checked_workflow_dispatch": {
          "id": 265670631,
          "name": "RSIP Tests",
          "path": ".github/workflows/test.yml"
        }
      },
      "ssh_aliases": {
        "github-rsip": {
          "hostname": "github.com",
          "user": "git"
        }
      }
